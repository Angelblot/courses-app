# Copy to .env and edit before running `docker compose up`.

# Required — 32-byte URL-safe base64 key for credential encryption.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# --- Authentification (Supabase Auth) ---
# L'API est fermée par défaut. Le backend ne délivre aucun jeton : il vérifie
# ceux que le front obtient auprès de Supabase.
#
# Projet à clés asymétriques (recommandé) — seule SUPABASE_URL est nécessaire,
# les clés publiques sont lues sur le JWKS du projet :
# Projet courses-app : https://qmymwicsgilhoihtfdjm.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co
#
# Projet à clés symétriques (historique) — Settings > API > JWT Secret :
# SUPABASE_JWT_SECRET=
#
# Audience attendue dans le jeton (défaut Supabase) :
# SUPABASE_JWT_AUDIENCE=authenticated
#
# Backend de développement volontairement ouvert — jamais en production :
# AUTH_ENABLED=false

# Optional — host port exposed on the container
APP_PORT=8000

# Origines autorisées, séparées par des virgules. "*" désactive
# automatiquement les credentials cross-origin (combinaison refusée par les
# navigateurs). Renseigne l'URL Vercel en production.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Optional — set true for FastAPI debug mode
DEBUG=false
