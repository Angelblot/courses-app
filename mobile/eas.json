{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "developpement": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "apercu": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "environment": "production"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
